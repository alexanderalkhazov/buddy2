DEFAULT_TICKER=AAPL
NEWSAPI_KEY=

# ── LLM provider: groq | gemini | openrouter | ollama | grok | anthropic ──
LLM_PROVIDER=groq

# Groq — FREE, no card. Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_SUMMARIZER_MODEL=llama-3.1-8b-instant

# Google Gemini — free tier. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter — free models. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama — local, no key needed
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# xAI Grok — PAID, requires credits
XAI_API_KEY=
GROK_MODEL=grok-4-latest

# Anthropic — paid
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

DB_PATH=storage/buddy.duckdb
